{
  "name": "fivemboosts-bots",
  "version": "1.0.0",
  "description": "Bots SantaGroup: backup do repo de API + listagem de boosts FiveM no Discord",
  "main": "index.js",
  "scripts": {
    "start": "concurrently -k -n bot,api,backup -c blue,green,yellow \"node boost-listing-bot.js\" \"node api.js\" \"node index.js\"",
    "start:backup": "node index.js",
    "start:bot": "node boost-listing-bot.js",
    "start:api": "node api.js",
    "once": "node index.js --once",
    "boosts": "node boost-listing-bot.js",
    "boosts:once": "node boost-listing-bot.js --once",
    "api": "node api.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "concurrently": "^10.0.1",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "form-data": "^4.0.1",
    "node-cron": "^3.0.3",
    "protobufjs": "^7.6.2"
  }
}
