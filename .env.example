# URL do webhook do Discord (Configurações do canal > Integrações > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxx/yyyyyyyyyy

# Repo no formato "usuario/repositorio" (ex: SantaGroup/fivemboosts)
GITHUB_REPO=usuario/repositorio

# Branch que sera baixada
GITHUB_BRANCH=main

# Token do GitHub (necessario se o repo for privado) - https://github.com/settings/tokens
GITHUB_TOKEN=

# Cron schedule - quando rodar o backup
# Exemplos:
#   "0 */6 * * *"  = a cada 6 horas
#   "0 3 * * *"    = todo dia as 3h da manha
#   "0 0 * * 0"    = todo domingo a meia-noite
BACKUP_CRON=0 8 * * *

# Timezone usado pelo cron (ex: America/Sao_Paulo, UTC)
BACKUP_TIMEZONE=America/Sao_Paulo

# Mensagem que acompanha o arquivo no Discord (deixe vazio para enviar so o ZIP)
BACKUP_MESSAGE=

# === Bot de listagem de boosts (discord.js) ===
# Token do bot do Discord - https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# ID do canal onde a listagem completa eh postada (1 mensagem editada continuamente)
BOOSTS_CHANNEL_ID=1435342049212629083

# ID do canal onde os alertas de alteracao de posicao sao postados
# (1 mensagem nova por pais que teve alteracao a cada checagem)
# Cobre: cidades SantaGroup (qualquer posicao) + top 5 dos paises onde temos cidade santa.
CHANGES_CHANNEL_ID=1504932168261042216

# ID do canal de alertas EMERGENCIAIS de RUSH no podio
# (so dispara quando nossa cidade eh top 1 do pais e alguem chega a <=1000 boosts de nos)
# Tambem informa cidades que perderam boost (possivel transferencia).
RUSH_CHANNEL_ID=1504937083771420802

# Frequencia da atualizacao + checagem de alteracoes (cron). Padrao: a cada 1 min
# (A lista de cidades SantaGroup por pais esta hardcoded em boost-listing-bot.js
#  na constante SANTA_BY_COUNTRY)
BOOSTS_LIST_CRON=* * * * *

# === Embeds adicionais (estilo bot Python) ===
# ID do canal para o embed "LISTAGEM DE POSIÇÕES" (azul, so cidades santa, editado continuamente)
POSICOES_CHANNEL_ID=
# ID do canal para o embed "LISTAGEM DE BOOSTS" (top 20 por pais com santa em destaque, editado continuamente)
BOOSTS_DELTAS_CHANNEL_ID=

# === WhatsApp Z-API (notificacao privada de alteracoes) ===
# URL base da instancia Z-API ex: https://api.z-api.io/instances/<INSTANCE>/token/<TOKEN>
ZAPI_BASE_URL=
# Client-token da Z-API (header client-token)
ZAPI_CLIENT_TOKEN=
# Numeros (ou IDs de grupo) que recebem a notificacao. Separe por virgula.
# Ex: 5522998151575,120363397083067700-group
ZAPI_NOTIFICATION_NUMBERS=
